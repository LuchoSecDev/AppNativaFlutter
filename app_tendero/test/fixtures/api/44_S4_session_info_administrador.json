    "headers": {
      "Set-Cookie": "connect.sid=<valor opaco>; Path=/; Expires=<30 minutos después de la última petición>; HttpOnly; SameSite=Strict"
    },
    "body": {
      "success": true,
      "userId": 1,
      "tiendaId": 1,
      "tiendaNombre": "Tienda La Esperanza",
      "limiteEgresoTendero": "150000.00",
      "rol": "Administrador",
      "nombres": "Marta Gómez",
      "cambioClaveForzoso": false,
      "needs2FASetup": false,
      "is2FAEnabled": true
    }
  }
}
